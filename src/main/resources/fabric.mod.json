{
	"schemaVersion": 1,
	"id": "xptracker",
	"version": "${version}",
	"name": "XPTracker",
	"description": "Tracks XP collection per session with source breakdown, efficiency stats, and a configurable HUD overlay.",
	"authors": [
		"Dennis_thegamer"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/xptracker",
		"issues": "https://github.com/DennisTheGamer/XPTracker/issues"
	},
	"license": "MIT",
	"icon": "assets/xptracker/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"de.dennisthegamer.xptracker.XPTrackerClient"
		],
		"modmenu": [
			"de.dennisthegamer.xptracker.config.XPTrackerModMenu"
		]
	},
	"mixins": [
		"xptracker.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~26.1-",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*",
		"yet_another_config_lib_v3": "*"
	}
}
